direction: down

vision: "VISION: Production-ready Go CQRS service framework in 15 lines\nNewService(cfg) -> svc.Run(ctx)" {
  shape: rectangle
  style.fill: "#f4d35e"
  style.font-color: "#0e0e10"
  style.bold: true
}

why: "WHY: httputil is HTTP-only (depguard-enforced).\ncqrs-lite/stack is the CQRS engine.\nappkit FRAMEWORK composes them + logging + lifecycle." {
  shape: rectangle
  style.fill: "#2a5a2a"
  style.font-color: "#f4f4f0"
  style.font-size: "14"
}

deps: "DEPENDENCIES (all same ecosystem):\nhttputil -> Server + Middleware + Health\ngo-cqrs-lite/stack/sqlite -> Event Store + CQRS + SQLite\ncharmbracelet/log -> Pretty slog handler\ngo-error-family -> Error classification" {
  shape: rectangle
  style.fill: "#1a1a3a"
  style.font-color: "#6eb5ff"
  style.font-size: "13"
}

d1: "DECISION 1:\nService owns mux + bundle?" {
  shape: diamond
  style.fill: "#3a3a1a"
  style.font-color: "#f4d35e"
}
d2: "DECISION 2:\nRun blocks + handles signals?" {
  shape: diamond
  style.fill: "#3a3a1a"
  style.font-color: "#f4d35e"
}
d3: "DECISION 3:\nSQLite via cqrs-lite/stack?" {
  shape: diamond
  style.fill: "#3a3a1a"
  style.font-color: "#f4d35e"
}

p1: Phase 1 — Foundation (1% to 51%) {
  style.fill: "#1a3a1a"
  style.stroke: "#2a5a2a"
  f1: "ServiceConfig + Service types\n(owns mux + bundle + logger)" {
    style.fill: "#2a5a2a"
    style.font-color: "#f4f4f0"
  }
  f2: "NewService(): validate -> logger\n-> stack/sqlite.New -> mux -> server" {
    style.fill: "#2a5a2a"
    style.font-color: "#f4f4f0"
  }
  f3: "Service.Run(): start -> signal\n-> shutdown bundle + server" {
    style.fill: "#2a5a2a"
    style.font-color: "#f4f4f0"
  }
  f4: "Accessors: Mux, Bundle,\nLogger, DB, Addr" {
    style.fill: "#2a5a2a"
    style.font-color: "#f4f4f0"
  }
}

p2: Phase 2 — Composition (4% to 64%) {
  style.fill: "#1a2a3a"
  style.stroke: "#2a4a6a"
  h1: "Add deps:\nhttputil + error-family +\ncqrs-lite/stack + charmbracelet/log" {
    style.fill: "#2a4a6a"
    style.font-color: "#f4f4f0"
  }
  h2: "Delegate server.go -> httputil.Server\n(appkit owns listener for net.Addr)" {
    style.fill: "#2a4a6a"
    style.font-color: "#f4f4f0"
  }
  h3: "Delegate health.go ->\nhttputil.RegisterHealth" {
    style.fill: "#2a4a6a"
    style.font-color: "#f4f4f0"
  }
  h4: "Default middleware stack:\nRecovery -> ReqID -> Logging -> Timeout -> Sec" {
    style.fill: "#2a4a6a"
    style.font-color: "#f4f4f0"
  }
}

p3: Phase 3 — Production-grade (20% to 80%) {
  style.fill: "#3a2a1a"
  style.stroke: "#5a4a2a"
  g1: "Coordinated Shutdown:\nserver -> bundle.Close with sync.Once" {
    style.fill: "#5a4a2a"
    style.font-color: "#f4f4f0"
  }
  g2: "errors.go: classify sentinels\n+ sqlite.Error via error-family" {
    style.fill: "#5a4a2a"
    style.font-color: "#f4f4f0"
  }
  g3: "DefaultServiceConfig()\n+ zero-value fill" {
    style.fill: "#5a4a2a"
    style.font-color: "#f4f4f0"
  }
}

p4: Phase 4 — Ship It (100%) {
  style.fill: "#2a1a2a"
  style.stroke: "#4a2a4a"
  s1: "README: framework pitch" {
    style.fill: "#4a2a4a"
    style.font-color: "#f4f4f0"
  }
  s2: "example/main.go" {
    style.fill: "#4a2a4a"
    style.font-color: "#f4f4f0"
  }
  s3: "Full test suite\n+ httpspec validation" {
    style.fill: "#4a2a4a"
    style.font-color: "#f4f4f0"
  }
  s4: "flake.nix + AGENTS.md\n+ doc.go" {
    style.fill: "#4a2a4a"
    style.font-color: "#f4f4f0"
  }
  s5: "Tag v1.0.0" {
    style.fill: "#4a2a4a"
    style.font-color: "#f4f4f0"
    style.bold: true
  }
}

vision -> why
why -> deps
deps -> d1
d1 -> p1.f1
p1.f1 -> d2
p1.f1 -> d3
d2 -> p1.f2
d3 -> p1.f2
p1.f2 -> p1.f3
p1.f3 -> p1.f4
p1.f4 -> p2.h1: "critical path"

p2.h1 -> p2.h2
p2.h1 -> p2.h3
p2.h2 -> p2.h4
p2.h3 -> p2.h4
p2.h4 -> p3.g1

p3.g1 -> p3.g2: "parallel"
p3.g1 -> p3.g3: "parallel"

p3.g2 -> p4.s1
p3.g3 -> p4.s2
p4.s1 -> p4.s3
p4.s2 -> p4.s3
p4.s3 -> p4.s4
p4.s4 -> p4.s5
