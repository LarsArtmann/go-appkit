#!/usr/bin/env bash
# ACTIVE pre-commit hook — lives in .githooks/ because the machine-wide
# git config sets core.hooksPath=.githooks (relative), which made the
# previous .git/hooks/pre-commit INERT: no guard has run at commit time
# since that override landed (found 2026-10-07, SUPERB T06/T07).
#
# Fatal: the eight OFFLINE standing guards (fast, read-only, no network)
# plus the per-module build+vet for the staged set (check-touched-modules).
# Warning-only: push-lag watch.
#
# Deliberately NOT the full BuildFlow pre-commit block: its dprint step
# exits 14 (no files to format) on CHANGELOG-only commits — a known
# upstream issue (Deferred Register) — and running it on every auto-commit
# daemon heuristic commit risks daemon lockups. Run `buildflow` manually;
# revisit when buildflow learns to skip empty staged sets.
# shellcheck shell=bash

set -u

GUARD_FAIL=0

for guard in check-go-directives.sh check-dependabot-parity.sh check-workspace-charter.sh check-sse-protocol.sh check-agents-deps.sh check-module-licenses.sh check-features-claims.sh check-response-drain.sh; do
	if ! ./scripts/"$guard" >/dev/null 2>&1; then
		echo "pre-commit: $guard FAILED (see scripts/$guard output)"
		GUARD_FAIL=1
	fi
done

# Tidy-stability for staged go.mods only (fleet-wide at pre-tag + CI): a
# checked-in go.mod that `go mod tidy` would rewrite churns on the next
# agent/BuildFlow tidy (the 2026-11-22/23 directive-reset class).
staged_gomods=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep '(^|/)go\.mod$' || true)
if [[ -n "$staged_gomods" ]]; then
	mods=()
	while IFS= read -r f; do mods+=("$(dirname "$f")"); done <<<"$staged_gomods"
	if ! ./scripts/check-go-tidy-stable.sh "${mods[@]}" >/dev/null 2>&1; then
		echo "pre-commit: check-go-tidy-stable.sh FAILED (staged go.mod must be tidy-stable — run 'GOWORK=off go mod tidy' in the module)"
		GUARD_FAIL=1
	fi
fi

# Shell-syntax gate for staged scripts (2026-11-23): scripts/lib/toolchain.sh
# shipped in one commit and the GOTOOLCHAIN=go1.27 invalid-partial class went
# unnoticed until the fleet sweep — bash -n would have caught it at commit.
while IFS= read -r sh; do
	if ! bash -n "$sh" 2>/dev/null; then
		echo "pre-commit: bash -n FAILED for $sh"
		GUARD_FAIL=1
	fi
done < <(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep '\.sh$' || true)

# check-pin-drift.sh and check-gosum-canonical.sh are deliberately NOT in
# the fatal set: their legs need the module proxy (network + downloads); an
# offline commit must not be blocked. pre-tag-checks.sh runs both where
# network exists; pin-drift also runs as a CI job (the fresh-runner matrix
# covers gosum-canonical's class).

# Hermetic reminder for integration/ changes (warn-only): the module must be
# verified with GOWORK=off — its suite self-enforces via TestMain (fails any
# non-hermetic invocation, incl. parent-launched `go test ./integration/...`
# which would resolve local code instead of the published pins).
if git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -q '^integration/'; then
echo "pre-commit NOTE: integration/ staged — verify hermetically: cd integration && GOWORK=off GOTOOLCHAIN=go1.27.4 go test ./... -race -count=1"
fi

# Per-module hermetic build+vet for every module the staged set touches
# (2026-11-06, 16-13 improvement #1 made mechanical). FATAL: a staged Go
# change must build and vet before it commits; doc-only staged sets verify
# zero modules and stay instant. Full test loops stay the session ritual
# (scripts/verify-all.sh / check-touched-modules.sh --tests) — pre-commit
# stays seconds, not minutes.
if ! ./scripts/check-touched-modules.sh; then
	echo "pre-commit: check-touched-modules.sh FAILED (staged Go changes must build+vet)"
	GUARD_FAIL=1
fi

if lag="$(./scripts/check-push-lag.sh 2>/dev/null)"; then
	:
else
	echo "pre-commit WARNING: $lag"
fi

if [ "${GUARD_FAIL:-0}" = "1" ]; then
	echo "pre-commit: project guards blocked the commit (fix, or commit with --no-verify + justification)"
	exit 1
fi

exit 0
