go 1.27.1

// ./integration is deliberately NOT a workspace member: it pins PUBLISHED
// tags only (pin charter in integration/doc.go), and workspace membership
// (a) resolves its pins to local code, contradicting the charter, and
// (b) merges its requires into the repo-level aggregate node in
// project-dependency-graph, creating a false cqrs-htmx cycle. Its documented
// verify is hermetic anyway: GOWORK=off (integration/README.md).
use (
	.
	./cqrs
	./docs
	./errorpages
	./flightrecorder
	./flightrecorderhealth
	./health
	./integration
	./otel
	./realtime
	./security
	./systemd
)

// Dev replaces for the systemscenario harness pilot (2026-10-09, ADR-0153):
// systemscenario is pre-tag, and it needs the system Clock seam (unpublished).
// Drop both when the next go-cqrs-lite tag wave ships systemscenario/v4 + system/v4.12.
replace github.com/larsartmann/go-cqrs-lite/systemscenario/v4 => /home/lars/projects/go-cqrs-lite/systemscenario
replace github.com/larsartmann/go-cqrs-lite/system/v4 => /home/lars/projects/go-cqrs-lite/system
