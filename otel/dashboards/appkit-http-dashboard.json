      "39d4f3f3-9dc6-43c5-bbf8-6b7691e4e5b0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request Rate",
            "description": "Spans per second per service from otelhttp server spans"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "stepInterval": 60,
                "signal": "traces",
                "source": "",
                "aggregations": [
                  {
                    "expression": "rate()"
                  }
                ],
                "disabled": false,
                "filter": {
                  "expression": "serviceName IN $service.name AND spanKind = 'Server'"
                },
                "groupBy": [
                  {
                    "name": "serviceName",
                    "signal": "",
                    "fieldContext": "",
                    "fieldDataType": "string"
                  }
                ],
                "order": [],
                "having": {
                  "expression": ""
                },
                "functions": [],
                "legend": "{{serviceName}}"
              }
            }
          ],
          "links": []
